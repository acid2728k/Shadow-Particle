{
  "name": "shadow-particle",
  "private": true,
  "workspaces": [
    "shared/protocol",
    "apps/bridge",
    "apps/frontend"
  ],
  "scripts": {
    "dev:bridge": "npm run dev -w @sp/bridge",
    "dev:frontend": "npm run dev -w @sp/frontend",
    "dev": "concurrently \"npm:dev:bridge\" \"npm:dev:frontend\"",
    "dev:kinect": "cd apps/kinect-bridge && chmod +x setup-and-run.sh 2>/dev/null; ./setup-and-run.sh",
    "dev:kinect:run": "cd apps/kinect-bridge && python3 kinect_bridge.py",
    "build": "npm run build -w @sp/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
